{
	"schemaVersion": 1,
	"id": "creeperhealing_sylvan",
	"version": "${version}",
	"name": "Creeper Healing: Sylvan Edition (Unofficial)",
	"description": "A server side, customizable Fabric mod to automatically and naturally heal Creeper explosions (and other types of explosions!).",
	"authors": [
		"ArkoSammy12"
	],
	"contributors": [
		"Sylvan-Cheng (26.1.2 port)"
	],
	"contact": {
		"homepage": "https://github.com/Sylvan-Cheng/creeper-healing-26.1.2",
		"sources": "https://github.com/Sylvan-Cheng/creeper-healing-26.1.2",
		"issues": "https://github.com/Sylvan-Cheng/creeper-healing-26.1.2/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/creeperhealing/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "io.github.arkosammy12.creeperhealing.CreeperHealing",
          {
            "adapter": "kotlin",
            "value": "io.github.arkosammy12.monkeyutils.MonkeyUtils"
          }
		]
	},
	"mixins": [
		"creeper-healing.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"custom": {
	  "lithium:options": {
		"mixin.world.explosions": false
	  }
	}
}
